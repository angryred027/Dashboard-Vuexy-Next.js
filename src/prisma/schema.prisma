datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model User {
  id            String   @id @default(uuid())
  name          String?
  userName      String?
  email         String   @unique
  password      String?  // Required for credentials login, nullable for OAuth
  image         String?
  emailVerified DateTime?
  fullName      String?
  telegram      String?
  role          Role      @default(user)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]  // Relation to OAuth accounts
  sessions Session[]  // Relation to sessions
}

enum Role {
  user
  admin
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String  @unique
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  status      Status    @default(active)
  planId      Int       @map("plan_id")
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

enum Status {
  active
  expired
  cancelled
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  amount          Decimal     @db.Decimal(10, 2)
  status          tStatus    @default(pending)
  transactionDate DateTime  @map("transaction_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("transactions")
}

enum tStatus {
  completed
  pending
  failed
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  price         Decimal    @db.Decimal(10, 2)
  durationDays  Int      @map("duration_days")
  benefits      String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  message   String   @db.Text
  type      Type     @default(personal)
  status    nStatus   @default(unread)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

enum Type {
  global
  personal
}

enum nStatus {
  read
  unread
}

model Affiliate {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  referralLink  String   @db.VarChar(255) @map("referral_link")
  referrals     Int      @default(0)
  commission    Decimal    @db.Decimal(10, 2) @default(0.00)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("affiliates")
}

model FAQ {
  id          Int      @id @default(autoincrement())
  question    String   @db.Text
  answer      String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  action    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
}
